<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        DOCSY PERMISSIONS AUDIT & NOTICE:
        Docsy operates STRICTLY OFFLINE. There is NO INTERNET permission.
        All data reading, OCR, classification, and searching happens entirely on-device.

        Note on Google Play Policies:
        SMS (READ_SMS), Call Log (READ_CALL_LOG), and All-Files access (MANAGE_EXTERNAL_STORAGE)
        are restricted permission declarations on Google Play. This build targets personal sideload
        installation for full on-device assistant functionality. Test flavors (noSmsCalls, filesOnly)
        are provided for Play Protect evaluation.
    -->

    <!-- STRICT OFFLINE: Remove INTERNET permission transitively pulled by any libraries -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- Storage Permissions: Required for walking and extracting on-device files from storage root -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />



    <!-- Communication & Contacts Permissions: Personal assistant queries on device -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Package Visibility: For installed apps inspection and version checks -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Sensor & Fitness Permissions: Step counting and live step sensor reading -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <!-- Hardware & State Permissions: Read-only live telemetry (Bluetooth, Network, Wi-Fi) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- System Services: Notifications, Background runs, Boot restart, and Biometrics -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Keep reading while the screen is off, and let the user exempt Docsy from battery optimisation -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />

    <!-- Health Connect package queries -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>

    <application
        android:name=".DocsyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.MyApplication">
        <!-- Lets the on-device vision model use the GPU (optional libraries, absent on some phones) -->
        <uses-native-library android:name="libvndksupport.so" android:required="false" />
        <uses-native-library android:name="libOpenCL.so" android:required="false" />


        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Health Connect Permission Rationale Activity & View Usage Alias -->
        <activity
            android:name=".ui.HealthPermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:targetActivity=".ui.HealthPermissionsRationaleActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- Reading Run Foreground Service -->
        <service
            android:name=".service.ReadingForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Step Diagnostics Foreground Service (diagnostic fallback only) -->
        <service
            android:name=".service.StepDiagnosticsForegroundService"
            android:exported="false"
            android:foregroundServiceType="health" />

    </application>

</manifest>
